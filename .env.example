# =========================================================
#  NeuroDesk AI - backend (api/)
#  Copiar este archivo como .env y completar. El .env NUNCA se sube a git.
# =========================================================

# --- Firebase Admin ---
# La service account entera, codificada en base64 en UNA sola variable.
# Se genera asi (PowerShell, desde la carpeta donde esta el json):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json")) | Set-Clipboard
# Va en base64 para esquivar el infierno de los \n del private_key.
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_PROJECT_ID=

# --- NVIDIA NIM (IA) ---
# Se saca en build.nvidia.com > Settings > API Keys. Se muestra UNA sola vez.
NVIDIA_API_KEY=
NVIDIA_API_KEY_BACKUP=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Los IDs van aca y NUNCA hardcodeados: si NVIDIA da de baja un modelo,
# se cambia esta linea y listo.
NVIDIA_MODELO_CHAT=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODELO_EMBED=nvidia/nemotron-3-embed-1b
EMBED_DIMS=1024

# --- OCR.space ---
# Plan gratis: 25.000 requests/mes, 1 MB por archivo.
OCR_SPACE_API_KEY=

# --- Mercado Pago (OPCIONAL - stretch goal) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Servidor ---
PORT=3000
