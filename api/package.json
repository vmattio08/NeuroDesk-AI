{
  "name": "neurodesk-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend de NeuroDesk AI: el unico que tiene las claves secretas",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test:rules": "npx --yes firebase-tools@15.34.1 emulators:exec --config ../firebase/firebase.emulador-tests.json --only firestore --project demo-neurodesk \"node --test test/rules.test.js\"",
    "modelos:vivos": "node --env-file=.env scripts/chequear-modelos.js",
    "probar:ia": "node --env-file=.env scripts/probar-ia.js",
    "probar:api": "node --env-file=.env scripts/probar-api.js",
    "calibrar": "node --env-file=.env scripts/calibrar-umbral.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:borrar": "node --env-file=.env scripts/borrar-seed.js",
    "set-admin": "node --env-file=.env scripts/set-admin.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "firebase-admin": "^14.3.0",
    "mammoth": "1.13.0",
    "multer": "^2.0.1",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0"
  }
}
